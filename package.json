{
  "name": "controle-financeiro-guilherme",
  "version": "1.0.0",
  "private": true,
  "description": "Controle financeiro pessoal com backend protegido por login.",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node --test tests/*.test.js",
    "test:smoke": "node scripts/test-refactor-smoke.js",
    "test:responsive": "node scripts/test-responsive-regressions.js",
    "docs:build": "node scripts/build-reconstruction-manual.js",
    "docs:verify": "node scripts/reconstruct-from-manual.js docs/MEUFIN-RECONSTRUCAO-COMPLETA.md",
    "test:perf:refactor": "node scripts/benchmark-refactor-dashboard.js",
    "check:refactor-risks": "node scripts/check-refactor-known-risks.js",
    "audit:ci": "npm audit --audit-level=high",
    "audit:system": "node scripts/system-audit.js",
    "check:legacy-paths": "node scripts/check-legacy-paths.js",
    "test:load": "node scripts/load-test.js",
    "test:e2e:import-bill": "node scripts/e2e-import-bill.js",
    "set-password": "node scripts/set-password.js",
    "set-developer-password": "node scripts/set-developer-password.js",
    "worker:pluggy": "node workers/worker_pluggy.js",
    "worker:oracle-ai": "node workers/worker_oracle_ai.js"
  },
  "dependencies": {
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "nodemailer": "^9.0.1",
    "oracledb": "^6.8.0",
    "session-file-store": "^1.5.0"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
